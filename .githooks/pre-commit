#!/bin/bash
# Only Git and Bash are required. Read the string-only generated array, not generators.
set -euo pipefail
[[ ${GAMMA_ALLOW_GENERATED:-} == 1 ]] && exit 0
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
[[ $branch =~ ^(feat|fix|perf|refactor|test|cand)/ ]] || exit 0
root=$(git rev-parse --show-toplevel)
manifest=$(<"$root/tools/generated-paths.json")
array=${manifest#*\"generated\"}
[[ $array != "$manifest" && $array == *'['* && $array == *']'* ]] || { echo 'Invalid tools/generated-paths.json' >&2; exit 1; }
array=${array#*[}
array=${array%%]*}
patterns=()
string='"([^"\\]*)"'
while [[ $array =~ $string ]]; do
  patterns+=("${BASH_REMATCH[1]}")
  array=${array#*\"}
  array=${array#*\"}
done
((${#patterns[@]})) || { echo 'Empty generated paths' >&2; exit 1; }
# Keep NUL delimiters, including tabs/newlines in paths.
git diff --cached --name-only -z | {
blocked=()
while IFS= read -r -d '' file; do
  for pattern in "${patterns[@]}"; do
    if [[ $file == $pattern ]]; then blocked+=("$file"); break; fi
  done
done
if ((${#blocked[@]})); then
  printf '生成物の commit を拒否しました:\n' >&2
  printf '  %s\n' "${blocked[@]}" >&2
  printf '%s\n' '規則: PUBLISH_RULES.md 進行ルールの見直し Q2' '統合役は GAMMA_ALLOW_GENERATED=1 で通す' >&2
  exit 1
fi
}
