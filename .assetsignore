# Worker assets come from the repository root. Never upload local credentials or Wrangler state.
/.git
/.git/**
/.gitignore
/.wrangler/**
/tools/**
/.dev.vars*
/.env*
/node_modules/**
/native-mac/**
/gamma-dev/**

# Developer checks and their results are not Worker assets.
/tests/**
/.github/**
/regression-results/**

# Patch rejects are local review notes, never public assets.
/*.rej

# Run of Show local validation and engineering notes stay out of deployed assets.
/run-of-show/verification/**
/run-of-show/TOKEN_SHEET.md
/run-of-show/INTEGRATION.md
